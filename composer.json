{
    "name": "ricardosierra/minify",
    "keywords": [
        "minify",
        "laravel5"
    ],
    "description": "A package for minifying styles and javascript for laravel 5 ",
    "license": "MIT",
    "authors": [
        {
            "name": "Da Costa Alcindo",
            "email": "alcindo.dacosta@ricardosierra.ch"
        }
    ],
    "require": {
        "php": "^8.3",
        "tedivm/jshrink": "~1.0",
        "natxet/cssmin": "3.*",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.16",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "psalm/plugin-laravel": "^1.5",
        "vimeo/psalm": "^4.0",
        "phpro/grumphp": ">=1.3"
    },
    "autoload": {
        "psr-4": {
            "RicardoSierra\\Minify\\": "src/"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "post-install-cmd": [],
        "post-update-cmd": [],
        "post-create-project-cmd": []
    },
    "replace": {
        "devfactory/minify": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "RicardoSierra\\Minify\\MinifyServiceProvider"
            ],
            "aliases": {
                "Minify": "RicardoSierra\\Minify\\Facades\\MinifyFacade"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "version": "2.0.0"
}
